<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>org.itech</groupId>
	<artifactId>dataexport</artifactId>
	<version>0.0.0.8</version>
	<packaging>pom</packaging>
	<name>Data Export</name>

	<properties>
		<java.version>11</java.version>
		<maven.compiler.release>11</maven.compiler.release>
	</properties>

	<repositories>
		<repository>
				<id>uwdigi-maven</id>
				<name>DIGI Public Repository</name>
				<url>s3://openelis-maven-repo/snapshots</url>
				<snapshots>
					<enabled>true</enabled>
				</snapshots>
		</repository>
	</repositories>
	<distributionManagement>
		<repository>
			<id>uwdigi-maven</id>
			<name>DIGI Public Repository</name>
			<url>s3://openelis-maven-repo/releases</url>
		</repository>
		<snapshotRepository>
			<id>uwdigi-maven</id>
			<name>DIGI Public Repository</name>
			<url>s3://openelis-maven-repo/snapshots</url>
		</snapshotRepository>
	</distributionManagement>

	<modules>
		<module>dataexport-api</module>
		<module>dataexport-core</module>
	</modules>

	<dependencies>
		<dependency>
			<groupId>ca.uhn.hapi.fhir</groupId>
			<artifactId>hapi-fhir-structures-r4</artifactId>
			<version>4.2.0</version>
		</dependency>
		<dependency>
			<groupId>ca.uhn.hapi.fhir</groupId>
			<artifactId>hapi-fhir-client</artifactId>
			<version>4.2.0</version>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>1.18.28</version>
			<scope>provided</scope>
		</dependency>

	</dependencies>

	<build>
		<extensions>
			<extension>
				<groupId>org.kuali.maven.wagons</groupId>
				<artifactId>maven-s3-wagon</artifactId>
				<version>1.2.1</version>
			</extension>
		</extensions>
		<plugins>
			<plugin>
				<groupId>com.spotify</groupId>
				<artifactId>dockerfile-maven-plugin</artifactId>
				<version>1.4.13</version>
				<inherited>false</inherited>
				<configuration>
					<skip>true</skip>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
